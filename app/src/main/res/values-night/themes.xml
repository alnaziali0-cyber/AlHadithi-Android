<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Night variant of the base theme. It only re-declares the window colours so the platform
      background follows the system dark mode; every other attribute is inherited from the base
      Theme.MyApplication definition in res/values/themes.xml.
    -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/kh_window_background</item>
        <item name="android:colorBackground">@color/kh_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
