<?xml version="1.0" encoding="utf-8"?>
<!--
  Alhadithi official notification icon.
  Android renders the small icon as an alpha mask, so the shape must be a solid
  silhouette on a transparent background. The silhouette mirrors the official
  Alhadithi logo: the crescent, the dome and the two minarets.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- Crescent -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M13.1,1.4a2.05,2.05 0 1,0 0,4.1a2.05,2.05 0 1,0 0,-4.1zM13.5,2.25a1.32,1.32 0 1,1 0,2.4a1.32,1.32 0 1,1 0,-2.4z" />
    <!-- Spire between the crescent and the dome -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.55,5.6h0.9v2.1h-0.9z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.85,7.7h0.3v1.1h-0.3z" />
    <!-- Dome outline (ring) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M5.2,14.9a6.8,6.8 0 0,1 13.6,0zM6.6,14.9a5.4,5.4 0 0,0 10.8,0z" />
    <!-- Minarets -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.7,11.9h1.1v6.6h-1.1zM18.2,11.9h1.1v6.6h-1.1z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.4,10.9h1.7v0.9h-1.7zM17.9,10.9h1.7v0.9h-1.7z" />
    <!-- Base band -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.4,18.5h17.2v1.4h-17.2z" />
</vector>
