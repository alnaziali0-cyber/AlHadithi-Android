<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Khazain Al-Huda base theme.

      The window background MUST be declared here. Without it the platform falls back to the
      DeviceDefault black window background, which is what produced the large black rectangle at
      the very top of the screen: the activity window was black while the Compose content only
      started below the status bar inset.

      The background is drawn edge-to-edge (the activity calls enableEdgeToEdge), so this colour is
      only the pre-draw / splash fallback and must match the light theme surface.
    -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/kh_window_background</item>
        <item name="android:colorBackground">@color/kh_window_background</item>
        <!-- Fully transparent system bars: the Compose surface owns the whole window. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Let the app draw into the display cutout area so notches never show a black band. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
