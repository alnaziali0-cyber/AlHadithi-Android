# Development only. In production inject these from a secrets manager.
APP_ENV=development
APP_SECRET=replace-with-a-random-32-byte-or-longer-secret
DATABASE_URL=sqlite:///./khazain_dev.db
ADMIN_BOOTSTRAP_USERNAME=KHAZAINAL-HUDA
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-strong-secret
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MEDIA_ROOT=./var/media
MAX_UPLOAD_BYTES=15728640
PUBLIC_API_CACHE_SECONDS=300
