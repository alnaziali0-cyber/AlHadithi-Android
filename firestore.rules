rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Bootstrapped Exclusive Developer/Owner Check (with anti-spoofing email_verified check)
    function isOwnerAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'alnaziali0@gmail.com';
    }

    function isValidAdminAnnouncement(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.authorEmail is string &&
             data.authorEmail.size() >= 5 &&
             data.authorEmail.size() <= 120 &&
             data.authorEmail == 'alnaziali0@gmail.com' &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.body is string &&
             data.body.size() >= 1 &&
             data.body.size() <= 1200 &&
             data.badgeLabel is string &&
             data.badgeLabel.size() >= 1 &&
             data.badgeLabel.size() <= 60 &&
             (!('actionUrl' in data) || data.actionUrl == null || (data.actionUrl is string && data.actionUrl.size() <= 500)) &&
             data.isActive is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /admin_announcements/{announcementId} {
      allow get: if isOwnerAdmin() &&
                    isValidId(announcementId) &&
                    existing().userId == request.auth.uid;

      allow list: if isOwnerAdmin() &&
                     existing().userId == request.auth.uid;

      allow create: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       incoming().keys().hasAll([
                         'title',
                         'body',
                         'badgeLabel',
                         'isActive',
                         'userId',
                         'authorEmail',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title',
                         'body',
                         'badgeLabel',
                         'actionUrl',
                         'isActive',
                         'userId',
                         'authorEmail',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidAdminAnnouncement(incoming());

      allow update: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       isValidAdminAnnouncement(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().authorEmail == existing().authorEmail &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title',
                         'body',
                         'badgeLabel',
                         'actionUrl',
                         'isActive',
                         'updatedAt'
                       ]);

      allow delete: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       existing().userId == request.auth.uid;
    }
  }
}
