rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Bootstrapped Exclusive Developer/Owner Check (with anti-spoofing email_verified check)
    function isOwnerAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'alnaziali0@gmail.com';
    }

    function isValidAdminAnnouncement(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.authorEmail is string &&
             data.authorEmail.size() >= 5 &&
             data.authorEmail.size() <= 120 &&
             data.authorEmail == 'alnaziali0@gmail.com' &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.body is string &&
             data.body.size() >= 1 &&
             data.body.size() <= 1200 &&
             data.badgeLabel is string &&
             data.badgeLabel.size() >= 1 &&
             data.badgeLabel.size() <= 60 &&
             (!('actionUrl' in data) || data.actionUrl == null || (data.actionUrl is string && data.actionUrl.size() <= 500)) &&
             data.isActive is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPrayerTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isOfficialPrayerRecord(data, expectedId) {
      return data.keys().hasAll([
          'governorateId', 'dateKey', 'fajr', 'sunrise', 'dhuhr', 'asr',
          'maghrib', 'isha', 'midnight', 'sourceUrl', 'sourceRecordId',
          'updatedAt', 'verifiedAt', 'timeZoneId', 'sourceCode', 'status'
        ]) &&
        data.keys().hasOnly([
          'governorateId', 'dateKey', 'fajr', 'sunrise', 'dhuhr', 'asr',
          'maghrib', 'isha', 'midnight', 'sourceUrl', 'sourceRecordId',
          'updatedAt', 'verifiedAt', 'timeZoneId', 'sourceCode', 'status'
        ]) &&
        data.governorateId in [
          'baghdad', 'basra', 'najaf', 'karbala', 'babil', 'wasit',
          'qadisiyah', 'muthanna', 'dhi_qar', 'maysan', 'diyala', 'anbar',
          'saladin', 'nineveh', 'kirkuk', 'erbil', 'sulaymaniyah', 'duhok'
        ] &&
        data.dateKey is string && data.dateKey.matches('^[0-9]{8}$') &&
        expectedId == data.governorateId + '_' + data.dateKey &&
        isValidPrayerTime(data.fajr) && isValidPrayerTime(data.sunrise) &&
        isValidPrayerTime(data.dhuhr) && isValidPrayerTime(data.asr) &&
        isValidPrayerTime(data.maghrib) && isValidPrayerTime(data.isha) &&
        isValidPrayerTime(data.midnight) &&
        data.fajr < data.sunrise && data.sunrise < data.dhuhr &&
        data.dhuhr < data.asr && data.asr < data.maghrib && data.maghrib < data.isha &&
        (data.midnight > data.maghrib || data.midnight < data.fajr) &&
        data.sourceUrl is string && (
          data.sourceUrl.matches('^https://(www\\.)?imamhussain\\.org/.*$') ||
          data.sourceUrl.matches('^https://(www\\.)?imamhussain\\.gov\\.iq/.*$')
        ) &&
        data.sourceRecordId is string && data.sourceRecordId.size() > 0 && data.sourceRecordId.size() <= 180 &&
        data.updatedAt is timestamp && data.verifiedAt is timestamp &&
        data.updatedAt <= data.verifiedAt &&
        data.updatedAt <= request.time && data.verifiedAt <= request.time &&
        data.timeZoneId == 'Asia/Baghdad' &&
        data.sourceCode == 'imamhussain_official' && data.status == 'published';
    }

    match /prayer_times_daily/{recordId} {
      // Prayer time records contain public timetable data only. Every record is validated
      // again by PrayerTimesService before display; only the verified owner can write them.
      allow get, list: if true;
      // Only the verified owner account can import or correct official source records.
      allow create, update: if isOwnerAdmin() && isOfficialPrayerRecord(incoming(), recordId);
      allow delete: if isOwnerAdmin() && existing().sourceCode == 'imamhussain_official';
    }

    match /admin_announcements/{announcementId} {
      allow get: if isOwnerAdmin() &&
                    isValidId(announcementId) &&
                    existing().userId == request.auth.uid;

      allow list: if isOwnerAdmin() &&
                     existing().userId == request.auth.uid;

      allow create: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       incoming().keys().hasAll([
                         'title',
                         'body',
                         'badgeLabel',
                         'isActive',
                         'userId',
                         'authorEmail',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title',
                         'body',
                         'badgeLabel',
                         'actionUrl',
                         'isActive',
                         'userId',
                         'authorEmail',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidAdminAnnouncement(incoming());

      allow update: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       isValidAdminAnnouncement(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().authorEmail == existing().authorEmail &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title',
                         'body',
                         'badgeLabel',
                         'actionUrl',
                         'isActive',
                         'updatedAt'
                       ]);

      allow delete: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       existing().userId == request.auth.uid;
    }
  }
}
