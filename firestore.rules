rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Bootstrapped Exclusive Developer/Owner Check (with anti-spoofing email_verified check)
    function isOwnerAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'alnaziali0@gmail.com';
    }

    function isValidAdminAnnouncement(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.authorEmail is string &&
             data.authorEmail.size() >= 5 &&
             data.authorEmail.size() <= 120 &&
             data.authorEmail == 'alnaziali0@gmail.com' &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.body is string &&
             data.body.size() >= 1 &&
             data.body.size() <= 1200 &&
             data.badgeLabel is string &&
             data.badgeLabel.size() >= 1 &&
             data.badgeLabel.size() <= 60 &&
             (!('actionUrl' in data) || data.actionUrl == null || (data.actionUrl is string && data.actionUrl.size() <= 500)) &&
             data.isActive is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /admin_announcements/{announcementId} {
      allow get: if isOwnerAdmin() &&
                    isValidId(announcementId) &&
                    existing().userId == request.auth.uid;

      // NOTE: `existing()` (resource) is null for list/query operations, so it must not be
      // referenced here. Referencing it made every list query fail with PERMISSION_DENIED,
      // which is why the developer panel could sign in successfully and still show no ads.
      // Ownership is enforced by the query filter (whereEqualTo("userId", uid)) on the client
      // plus the isOwnerAdmin() role check below.
      allow list: if isOwnerAdmin();

      allow create: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       incoming().keys().hasAll([
                         'title',
                         'body',
                         'badgeLabel',
                         'isActive',
                         'userId',
                         'authorEmail',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title',
                         'body',
                         'badgeLabel',
                         'actionUrl',
                         'isActive',
                         'userId',
                         'authorEmail',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidAdminAnnouncement(incoming());

      allow update: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       isValidAdminAnnouncement(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().authorEmail == existing().authorEmail &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title',
                         'body',
                         'badgeLabel',
                         'actionUrl',
                         'isActive',
                         'updatedAt'
                       ]);

      allow delete: if isOwnerAdmin() &&
                       isValidId(announcementId) &&
                       existing().userId == request.auth.uid;
    }

    // ── إعلانات التطبيق (Ads) ────────────────────────────────────────
    // Every end user may read the ads that are currently published; only the
    // verified owner account may create, edit, schedule, pause or delete them.
    function isValidAd(data) {
      return data.title is string &&
             data.title.size() >= 2 && data.title.size() <= 140 &&
             data.text is string &&
             data.text.size() >= 2 && data.text.size() <= 2000 &&
             (!('shortDesc' in data) || data.shortDesc == null ||
               (data.shortDesc is string && data.shortDesc.size() <= 300)) &&
             (!('link' in data) || data.link == null ||
               (data.link is string && data.link.size() <= 500)) &&
             (!('ctaLabel' in data) || data.ctaLabel == null ||
               (data.ctaLabel is string && data.ctaLabel.size() <= 60)) &&
             (!('imagePath' in data) || data.imagePath == null ||
               (data.imagePath is string && data.imagePath.size() <= 500)) &&
             data.status is string &&
             data.status in ['draft', 'scheduled', 'active', 'paused', 'expired'] &&
             data.target is string &&
             data.target in ['all', 'users', 'guests', 'role'] &&
             (!('targetRole' in data) || data.targetRole == null ||
               (data.targetRole is string && data.targetRole.size() <= 40)) &&
             (!('sendPush' in data) || data.sendPush is bool) &&
             (!('startAt' in data) || data.startAt == null || data.startAt is timestamp) &&
             (!('endAt' in data) || data.endAt == null || data.endAt is timestamp);
    }


    match /ads/{adId} {
      // Authoring copy — only the verified owner may read or write it.
      allow read: if isOwnerAdmin();
      allow list: if isOwnerAdmin();
      allow create: if isOwnerAdmin() && isValidId(adId) && isValidAd(incoming());
      allow update: if isOwnerAdmin() && isValidId(adId) && isValidAd(incoming());
      allow delete: if isOwnerAdmin() && isValidId(adId);
    }

    // Published snapshot of an ad. Only the owner writes it; every app user reads it.
    // Keeping the live copy in its own collection means end-user queries never depend on
    // a `resource.data` condition, which Firestore cannot always prove for a query.
    match /published_ads/{adId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isOwnerAdmin() && isValidId(adId);
    }

    // ── أجهزة الإشعارات (Push device registry) ───────────────────────
    // Each signed-in device registers and removes only its own subscription.
    match /notification_devices/{deviceId} {
      allow read: if isOwnerAdmin();
      allow list: if isOwnerAdmin();
      allow create: if isSignedIn() &&
                       isValidId(deviceId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().endpoint is string &&
                       incoming().endpoint.size() >= 16 &&
                       incoming().endpoint.size() <= 1000;
      allow update: if isSignedIn() &&
                       isValidId(deviceId) &&
                       resource.data.userId == request.auth.uid &&
                       incoming().userId == request.auth.uid;
      allow delete: if isOwnerAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── تفضيلات الإشعارات (per-user preferences) ─────────────────────
    match /notification_prefs/{userId} {
      allow read: if isOwnerAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isOwnerAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ── سجل عمليات الإرسال (delivery log) ────────────────────────────
    match /notification_log/{logId} {
      allow read: if isOwnerAdmin() ||
                    (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isOwnerAdmin();
      allow create: if isSignedIn() &&
                       isValidId(logId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().kind is string &&
                       incoming().kind.size() <= 40 &&
                       incoming().status is string &&
                       incoming().status.size() <= 40;
      allow update: if isOwnerAdmin();
      allow delete: if isOwnerAdmin();
    }

    // ── سجل عمليات المطور (audit trail) ──────────────────────────────
    match /admin_audit_log/{logId} {
      allow read: if isOwnerAdmin();
      allow list: if isOwnerAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
