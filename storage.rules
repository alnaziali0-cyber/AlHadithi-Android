rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Only the verified owner account may upload or delete advertisement media.
    function isOwnerAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'alnaziali0@gmail.com';
    }

    match /ads/{adId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwnerAdmin() &&
                      request.resource.size < 8 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if isOwnerAdmin();
    }

    // Everything else is closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
